# Copy to .env (gitignored) and fill in. Real environment variables take priority over this file.

# Free key from your Rebrickable profile → Settings → API. Needed for MOC parts lists and set alternates.
REBRICKABLE_API_KEY=

# Optional: path to Rebrickable's all_downloads.zip (default: data/rebrickable/all_downloads.zip)
LEGOFINDER_CATALOGUE=
